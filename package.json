{
  "name": "task-management-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-integration.ps1",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-e2e.ps1",
    "test:e2e:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-e2e.ps1 -Headed",
    "test:e2e:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-e2e.ps1 -Ui",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "check:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-full.ps1",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:ps": "docker compose ps",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:create": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/db-create-test.ps1",
    "db:e2e:create": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/db-create-e2e.ps1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
